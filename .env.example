# Configuración opcional del prototipo local (los valores por defecto sirven).
# Copiá este archivo como .env.local si querés cambiar algo.

# Dónde se guarda la base de datos SQLite.
# CO_DB_RUTA=datos/operaciones.db

# Puertos de la app web y del servidor de datos.
# CO_PUERTO_WEB=5173
# CO_PUERTO_API=5174

# --- Build de la app publicada (Supabase). Solo hacen falta para construir la
# versión que usa Supabase en vez del servidor local. La clave es la
# "publicable" (sb_publishable_…), hecha para ir en el navegador.
# VITE_CO_BACKEND=supabase
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Carpeta donde se publica (GitHub Pages: /DailyGui/). Por defecto, la raíz.
# CO_BASE=/
